# Docker build context — frontend.
# The Dockerfile runs `npm ci` and `npm run build` inside the image, so host
# dependencies and previous build output must NEVER be copied in: a Windows
# node_modules would break the alpine build, and a stale dist would be served.
# Files the build legitimately needs (package.json, package-lock.json,
# index.html, *.config.js, src/, nginx.conf) are deliberately NOT excluded.

# Dependencies — reinstalled by `npm ci` during the build
node_modules
**/node_modules

# Build output — regenerated by `npm run build`
dist
build
coverage

# Vite/tooling caches
.vite
.eslintcache

# Secrets: real env files never enter an image. Templates are kept.
.env
.env.*
!.env.example

# Version control and tooling metadata
.git
.gitignore

# OS / editor noise
*.log
.DS_Store
Thumbs.db
