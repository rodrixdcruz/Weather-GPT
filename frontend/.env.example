# WeatherGPT frontend configuration (copy to .env and edit).

# In dev, Vite proxies /api to http://localhost:8000 (see vite.config.js),
# so this can stay unset. For a separately-deployed backend, set the full
# base URL here — src/lib/api.js reads it via import.meta.env.
#
# Not needed in production: the nginx image serves the app and proxies /api/ to
# backend:8000 itself, so production builds nothing from this file.
VITE_API_BASE_URL=

# Dev server only: why Vite's /api proxy forwards to. Defaults to
# http://backend:8000 (the compose service name), which resolves inside the
# compose network. When running the dev server directly on the host, set
# http://localhost:8000 instead.
VITE_API_PROXY_TARGET=
