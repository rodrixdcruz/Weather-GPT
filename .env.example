# Docker Compose configuration for the MausamBagha AI stack.
#
#   cp .env.example .env      # then edit — .env is gitignored
#
# Both compose files read these values for ${VAR:-default} interpolation:
#   docker-compose.yml        development stack (Vite dev server on 5173)
#   docker-compose.prod.yml   production stack (nginx on 80, built images)
#
# THIS FILE IS COMMITTED. It must never contain a real key, password or token.
# Real values belong in `.env`, which is ignored by git.

# --- Public entry point ---
# Host port that maps to the frontend container's port 80 (production stack).
FRONTEND_PORT=80

# "production" turns on the startup guard that warns about development
# defaults and is what you want on a real deployment.
ENV=production
LOG_LEVEL=INFO

# Browser origins allowed to call the API. Set this to your real frontend
# origin(s) if the API is ever called cross-origin, e.g.
#   CORS_ORIGINS=["https://weathergpt.example.com"]
# Behind the production nginx image the SPA calls /api/ on its own origin, so
# CORS is not exercised at all.
CORS_ORIGINS=["http://localhost:5173"]

# Interactive API docs (/docs, /redoc, /openapi.json). Keep false in production.
DOCS_ENABLED=false

# --- Database (internal to the compose network; never published) ---
# NOTE: Postgres only applies POSTGRES_PASSWORD when it initializes a volume.
# Changing this on an existing pgdata volume requires an ALTER USER as well.
POSTGRES_USER=weathergpt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=weathergpt

# --- Weather + air quality (open_meteo needs NO key) ---
WEATHER_PROVIDER=open_meteo
AIR_QUALITY_ENABLED=true
RISK_PROFILE=default
SAFETY_ALERT_PROVIDER=null

# --- AI tiers ---
# mock = deterministic rule-based replies (no service needed)
# ollama / hybrid = local Ollama (optional `ai` profile)
AI_PROVIDER=mock
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# Free cloud escalation tier for the hybrid provider (see presets.py).
# Leave the keys EMPTY to use the keyless tier; never commit a real key.
ESCALATION_PROVIDER=auto
ESCALATION_PROVIDERS=
ESCALATION_COOLDOWN_SECONDS=65
ESCALATION_API_KEY=
ESCALATION_API_KEYS=
ESCALATION_MODEL=
ESCALATION_BASE_URL=
ESCALATION_TIMEOUT_SECONDS=30

# Legacy paid tier (only read when ESCALATION_PROVIDER=solar).
SOLAR_API_KEY=
SOLAR_MODEL=solar-pro4
SOLAR_API_BASE_URL=https://api.upstage.ai/v1/solar

# Local RAG over the bundled safety knowledge base.
RAG_ENABLED=true
RAG_TOP_K=3

# --- Dashboard accounts ---
# REQUIRED in the production stack: it refuses to start without
# AUTH_ADMIN_PASSWORD, so a published default can never reach a live site.
# Seeding is idempotent — it only creates accounts that do not exist yet, so
# changing these does NOT change a password already stored in the database.
AUTH_ENABLED=true
AUTH_AUTO_INIT_DB=true
AUTH_SESSION_TTL_HOURS=12
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_ADMIN_DISPLAY_NAME=Operations Admin
# The demo login is a known-credential account: set a real password or remove
# the `demo` row before exposing the app publicly.
AUTH_DEMO_USERNAME=demo
AUTH_DEMO_PASSWORD=change-me
AUTH_DEMO_DISPLAY_NAME=Demo User

# --- SOS ---
# Keep false until a real dispatch integration exists: the app must never
# claim an SOS was sent when nothing was dispatched.
SOS_DISPATCH_ENABLED=false
SOS_DISPATCH_WEBHOOK_URL=
