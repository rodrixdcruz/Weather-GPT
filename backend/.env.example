# MausamBagha AI backend — every setting the app reads, with placeholders.
#
# Copy to `backend/.env` ONLY if you run the backend outside Docker Compose.
# With compose the root `weathergpt/.env` is injected instead.
#
# THIS FILE MUST NEVER CONTAIN A REAL KEY. It is committed; `.env` is not.
# Values here are overridden by real environment variables.

# --- App ---
APP_NAME=MausamBagha AI
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Interactive API docs (/docs, /redoc, /openapi.json). Set false in production:
# it hides the documentation surface only — endpoint paths and behaviour are
# unchanged.
DOCS_ENABLED=true

# --- Database (Postgres + PostGIS). The +psycopg part is required. ---
DATABASE_URL=postgresql+psycopg://weathergpt:weathergpt@localhost:5432/weathergpt

# --- AI provider selection ---
# mock | ollama | hybrid | openai
# "hybrid" = local Ollama first, then the free cloud escalation tier below.
AI_PROVIDER=hybrid
AI_API_KEY=
AI_MODEL=

# --- Local AI (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# --- Escalation tier (hybrid only). All FREE, no credit card. ---
# auto | groq | gemini | nvidia | openrouter | mistral | ovhcloud | solar
#   auto      = groq when ESCALATION_API_KEY is set, else keyless ovhcloud
#   ovhcloud  = needs NO API KEY at all (2 req/min per IP)
#   solar     = the legacy PAID tier, still supported via the SOLAR_* vars below
ESCALATION_PROVIDER=auto

# Optional ORDERED FAILOVER CHAIN (comma-separated preset names). When the
# first provider is rate-limited or unreachable, the next is tried
# automatically, so one exhausted tier no longer drops chat to data-only
# answers. Recommended with a free Groq key:
#   ESCALATION_PROVIDERS=groq,ovhcloud
# Empty = single provider (whatever ESCALATION_PROVIDER resolves to), no
# failover — the previous behavior.
ESCALATION_PROVIDERS=

# Per-provider keys for the chain, as a JSON map, e.g.:
#   ESCALATION_API_KEYS={"groq":"gsk_yourkey","gemini":"yourkey"}
# A single ESCALATION_API_KEY still works: it is applied to the first
# key-needing provider in the chain that has no key of its own.
ESCALATION_API_KEYS=

# Seconds a rate-limited provider sits out (429s cannot recover sooner, so
# retrying earlier only wastes latency; failover covers the window).
ESCALATION_COOLDOWN_SECONDS=65

# Leave EMPTY to use the keyless tier. Never commit a real key.
ESCALATION_API_KEY=
# Override the preset's defaults (any OpenAI-compatible endpoint works).
ESCALATION_MODEL=
ESCALATION_BASE_URL=
ESCALATION_TIMEOUT_SECONDS=30

# --- Legacy Solar Pro 4 (only read when ESCALATION_PROVIDER=solar) ---
SOLAR_API_KEY=
SOLAR_MODEL=solar-pro4
SOLAR_API_BASE_URL=https://api.upstage.ai/v1/solar

# --- Local RAG over the trusted knowledge base ---
RAG_ENABLED=true
RAG_TOP_K=3
RAG_KNOWLEDGE_DIR=

# --- Weather + air quality data ---
# mock | open_meteo   (open_meteo is key-less)
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=
AIR_QUALITY_ENABLED=true

# --- Road routing proxy (FOSSGIS OSRM, key-less) ---
# The backend proxies /api/v1/routing/* so all visitors share one server-side
# cache and FOSSGIS sees a single well-behaved client. Empty = the public
# FOSSGIS instance; override with a self-hosted OSRM base URL if needed.
ROUTING_OSRM_BASE_URL=

# --- Risk engine profile (profiles/<name>.json) ---
RISK_PROFILE=default

# --- Safety alerts. "null" = never fabricate official alerts. ---
SAFETY_ALERT_PROVIDER=null

# --- Dashboard auth. CHANGE THESE beyond a local demo. ---
# Seeding is idempotent: it only creates accounts that do NOT exist yet, so
# changing these does not change a password already stored in the database.
AUTH_ENABLED=true
AUTH_SESSION_TTL_HOURS=12
AUTH_ADMIN_USERNAME=admin
# Use a real secret; this default exists only so a fresh checkout can be demoed.
AUTH_ADMIN_PASSWORD=change-me
AUTH_ADMIN_DISPLAY_NAME=Operations Admin
AUTH_DEMO_USERNAME=demo
AUTH_DEMO_PASSWORD=change-me
AUTH_DEMO_DISPLAY_NAME=Demo User
AUTH_AUTO_INIT_DB=true

# --- SOS. Leave disabled until a real dispatch service is wired up. ---
# The app must never claim an SOS was sent when this is false.
SOS_DISPATCH_ENABLED=false
SOS_DISPATCH_WEBHOOK_URL=
